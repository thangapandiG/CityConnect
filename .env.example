# Environment Variable Configuration for CityConnect Platform

# Production / Vercel API Base URL
# Leave blank or set to '/api' when deploying frontend & backend serverless API in the same Vercel project.
# Set to 'http://localhost:3001/api' during local development if testing cross-origin backend calls.
VITE_API_BASE_URL=/api

# Express Server Port (Local Dev Server)
PORT=3001
